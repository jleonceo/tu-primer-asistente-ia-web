---
import { marca, nav } from '../data/site.js';
---
<header id="cab" class="sticky top-0 z-50 bg-papel transition-shadow duration-300">
  <div class="mx-auto flex max-w-[960px] items-center justify-between px-6 py-[15px]">
    <a href="/" class="font-display text-[1.05rem] font-bold leading-tight tracking-tight text-tinta no-underline">
      {marca.nombre}<span class="text-acento">{marca.nombreAcento}</span>
    </a>
    <nav class="flex flex-wrap items-center justify-end gap-x-[18px] gap-y-2" aria-label="Principal">
      {nav.map((i) => (
        i.cta ? (
          <a href={i.href} class="inline-flex min-h-[44px] items-center rounded-xl bg-acento px-[15px] py-[8px] text-[.85rem] font-semibold text-white no-underline shadow-[0_4px_14px_rgba(46,106,87,.22)] transition hover:-translate-y-0.5 hover:bg-acento-deep">{i.texto}</a>
        ) : (
          <a href={i.href} class="inline-flex min-h-[44px] items-center text-[.88rem] text-suave no-underline transition hover:text-acento">{i.texto}</a>
        )
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var c = document.getElementById('cab');
    if (!c) return;
    function on() { c.classList.toggle('cab-on', window.scrollY > 8); }
    on();
    window.addEventListener('scroll', on, { passive: true });
  })();
</script>

<style>
  #cab { border-bottom: 1px solid transparent; }
  #cab.cab-on {
    border-bottom-color: var(--color-linea);
    box-shadow: 0 6px 22px rgba(28, 33, 43, .06);
  }
</style>
