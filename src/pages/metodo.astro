---
import Layout from '../layouts/Layout.astro';
import { metodo } from '../data/metodo.js';
const { meta, hero, contraste, principios, honestidades, simulaciones, cierre } = metodo;
---
<Layout title={meta.title} description={meta.description}>

  <section class="px-6 pb-[40px] pt-[70px] text-center">
    <div class="mx-auto max-w-[720px]">
      <div class="eyebrow mb-3">{hero.k}</div>
      <h1 class="mb-4 text-[clamp(2rem,5vw,2.8rem)] font-bold leading-[1.06]">{hero.titulo}</h1>
      <p class="mx-auto max-w-[56ch] text-[1.12rem] text-suave">{hero.lead}</p>
    </div>
  </section>

  <div class="mx-auto max-w-[820px] px-6">

    <!-- CONTRASTE -->
    <section class="reveal mb-12">
      <h2 class="mb-6 text-center text-[1.6rem] font-bold">{contraste.titulo}</h2>
      <div class="space-y-3">
        {contraste.filas.map((f) => (
          <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
            <div class="rounded-md border border-linea bg-crema-deep px-5 py-4">
              <div class="mb-1 text-[.78rem] font-bold text-suave">Lo que se cree</div>
              <p class="text-[.97rem] text-suave line-through decoration-[#c9c9c4]">{f.otros}</p>
            </div>
            <div class="rounded-md border-l-4 border-acento bg-crema-deep px-5 py-4">
              <div class="mb-1 text-[.78rem] font-bold text-acento">Lo que hemos comprobado</div>
              <p class="text-[.97rem] text-tinta">{f.nosotros}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- PRINCIPIOS -->
    <section class="reveal mb-12 rounded-lg border border-linea bg-papel px-8 py-[40px]">
      <div class="eyebrow text-center">{principios.k}</div>
      <h2 class="mb-7 mt-1 text-center text-[1.6rem] font-bold">{principios.titulo}</h2>
      <div class="grid grid-cols-1 gap-x-[36px] gap-y-5 md:grid-cols-2">
        {principios.items.map((p) => (
          <div class="flex items-start gap-3">
            <span aria-hidden="true" class="mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-md bg-[rgba(46,106,87,.16)] text-[.82rem] font-bold text-verde">✓</span>
            <div>
              <b class="block text-[1rem] text-tinta">{p.b}</b>
              <span class="text-[.93rem] text-suave">{p.span}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- HONESTIDADES (oscuro) -->
    <section class="reveal grano mb-12 rounded-lg bg-tinta px-8 py-[40px] text-[#eef0f3]">
      <h2 class="mb-6 text-center text-[1.5rem] font-bold text-white">{honestidades.titulo}</h2>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        {honestidades.items.map((h) => (
          <div class="rounded-md bg-[rgba(255,255,255,.04)] px-5 py-4">
            <b class="mb-1 block text-[1rem] text-white">{h.b}</b>
            <span class="text-[.9rem] text-[#b9bfc9]">{h.span}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- SIMULACIONES: probar antes de confiar (sección-guía) -->
    <section class="reveal mb-12">
      <div class="mb-7 text-center">
        <div class="eyebrow eyebrow-c mx-auto mb-3">{simulaciones.k}</div>
        <h2 class="mb-3 text-[1.6rem] font-bold">{simulaciones.titulo}</h2>
        <p class="mx-auto max-w-[60ch] text-[1.05rem] text-suave">{simulaciones.lead}</p>
      </div>

      <!-- 1 · Por qué probar -->
      <div class="mb-4 rounded-lg border border-linea bg-papel px-7 py-6">
        <h3 class="mb-2 text-[1.18rem] font-bold">{simulaciones.porQue.titulo}</h3>
        <p class="mb-3 text-[.99rem] leading-relaxed text-tinta-soft">{simulaciones.porQue.texto}</p>
        <p class="rounded-md bg-crema-deep px-4 py-3 text-[.93rem] italic leading-relaxed text-suave">{simulaciones.porQue.analogia}</p>
      </div>

      <!-- 2 y 3 · referencia + regresión, en pareja -->
      <div class="mb-4 grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="rounded-lg border border-linea bg-papel px-7 py-6">
          <h3 class="mb-2 text-[1.18rem] font-bold">{simulaciones.referencia.titulo}</h3>
          <p class="mb-3 text-[.99rem] leading-relaxed text-tinta-soft">{simulaciones.referencia.texto}</p>
          <p class="rounded-md bg-crema-deep px-4 py-3 text-[.93rem] italic leading-relaxed text-suave">{simulaciones.referencia.analogia}</p>
        </div>
        <div class="rounded-lg border border-linea bg-papel px-7 py-6">
          <h3 class="mb-2 text-[1.18rem] font-bold">{simulaciones.regresion.titulo}</h3>
          <p class="mb-3 text-[.99rem] leading-relaxed text-tinta-soft">{simulaciones.regresion.texto}</p>
          <p class="rounded-md border border-acento-claro bg-[#f3f9f6] px-4 py-3 text-[.93rem] font-semibold leading-relaxed text-acento">{simulaciones.regresion.remate}</p>
          {simulaciones.regresion.experiencia && (
            <p class="mt-3 border-l-4 border-linea pl-4 text-[.9rem] italic leading-relaxed text-suave"><b class="not-italic text-acento-deep">Lo que vimos montándolo:</b> {simulaciones.regresion.experiencia}</p>
          )}
        </div>
      </div>

      <!-- 4 · niveles según el riesgo -->
      <div class="mb-4 rounded-lg border border-linea bg-papel px-7 py-6">
        <h3 class="mb-1 text-[1.18rem] font-bold">{simulaciones.niveles.titulo}</h3>
        <p class="mb-4 text-[.95rem] text-suave">{simulaciones.niveles.intro}</p>
        <div class="space-y-3">
          {simulaciones.niveles.items.map((it, i) => (
            <div class="flex items-start gap-3">
              <span class="nivel-num flex-none text-[1.5rem] leading-none">{i + 1}</span>
              <div>
                <b class="block text-[1rem] text-tinta">{it.b}</b>
                <span class="text-[.94rem] leading-relaxed text-suave">{it.span}</span>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-4 text-[.95rem] leading-relaxed text-tinta-soft">{simulaciones.niveles.remate}</p>
      </div>

      <!-- 5 · marco: guía + criterio (oscuro, para cerrar la idea) -->
      <div class="rounded-lg border-l-4 border-acento bg-papel px-7 py-6">
        <h3 class="mb-2 text-[1.18rem] font-bold text-tinta">{simulaciones.marco.titulo}</h3>
        <p class="mb-3 text-[.99rem] leading-relaxed text-tinta-soft [&_b]:font-semibold [&_b]:text-acento-deep" set:html={simulaciones.marco.texto} />
        <p class="text-[.96rem] font-semibold leading-relaxed text-acento">{simulaciones.marco.remate}</p>
      </div>
    </section>

    <!-- CIERRE -->
    <div class="mb-[60px] text-center">
      <p class="mb-5 text-[1.05rem] text-suave">{cierre.texto}</p>
      <a href={cierre.href} class="btn-acento text-[1.05rem]">{cierre.cta}</a>
    </div>

  </div>
</Layout>
