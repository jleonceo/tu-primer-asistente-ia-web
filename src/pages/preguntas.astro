---
import Layout from '../layouts/Layout.astro';
import { preguntas } from '../data/preguntas.js';
const { meta, hero, grupos, cta } = preguntas;
---
<Layout title={meta.title} description={meta.description}>

  <section class="px-6 pb-[36px] pt-[70px] text-center">
    <div class="mx-auto max-w-[680px]">
      <div class="eyebrow eyebrow-c mx-auto mb-3">{hero.k}</div>
      <h1 class="mb-4 text-[clamp(2rem,5vw,2.7rem)] font-bold leading-[1.08]">{hero.titulo}</h1>
      <p class="mx-auto max-w-[50ch] text-[1.12rem] text-suave">{hero.lead}</p>
    </div>
  </section>

  <div class="mx-auto max-w-[720px] px-6">
    {grupos.map((g) => (
      <section class="reveal mb-9">
        <h2 class="mb-3 text-[1.25rem] font-bold text-tinta">{g.titulo}</h2>
        <div class="space-y-3">
          {g.items.map((it) => (
            <details class="group rounded-lg border border-linea bg-papel px-6">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 [&::-webkit-details-marker]:hidden">
                <span class="text-[1.02rem] font-semibold text-tinta">{it.q}</span>
                <span aria-hidden="true" class="flex-none text-[1.2rem] text-acento transition-transform duration-200 group-open:rotate-45">+</span>
              </summary>
              <p class="pb-5 text-[.97rem] leading-relaxed text-suave">{it.a}</p>
            </details>
          ))}
        </div>
      </section>
    ))}

    <div class="mt-12 mb-[60px] text-center">
      <a href={cta.href} class="btn-acento text-[1.05rem]">
        {cta.texto}
        <span class="mt-[10px] block text-[.85rem] font-normal text-acento-claro">{cta.sub}</span>
      </a>
    </div>
  </div>

</Layout>
