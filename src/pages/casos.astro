---
import Layout from '../layouts/Layout.astro';
import { casos } from '../data/casos.js';
const { meta, hero, items, cierre } = casos;
---
<Layout title={meta.title} description={meta.description}>

  <section class="px-6 pb-[40px] pt-[70px] text-center">
    <div class="mx-auto max-w-[720px]">
      <div class="eyebrow mb-3">{hero.k}</div>
      <h1 class="mb-4 text-[clamp(2rem,5vw,2.7rem)] font-bold leading-[1.08]">{hero.titulo}</h1>
      <p class="mx-auto max-w-[56ch] text-[1.12rem] text-suave">{hero.lead}</p>
    </div>
  </section>

  <div class="mx-auto max-w-[820px] space-y-10 px-6">
    {items.map((c) => (
      <article class="reveal overflow-hidden rounded-lg border border-linea bg-papel">

        <!-- Cabecera del caso -->
        <div class="border-b border-linea bg-crema px-8 py-6">
          <span class="mb-2 inline-block rounded-full border border-linea bg-papel px-[10px] py-[3px] text-[.72rem] font-semibold text-suave">{c.perfil}</span>
          <h2 class="text-[1.5rem] font-bold leading-tight">{c.titulo}</h2>
        </div>

        <div class="space-y-7 px-8 py-7">

          <!-- Problema -->
          <div>
            <div class="eyebrow mb-1">El problema</div>
            <p class="text-[1rem] leading-relaxed text-suave">{c.problema}</p>
          </div>

          <!-- Las 4 decisiones -->
          <div>
            <div class="eyebrow mb-2">Las cuatro decisiones</div>
            <div class="overflow-hidden rounded-md border border-linea">
              {c.decisiones.map((d, j) => (
                <div class={`flex flex-col gap-1 px-4 py-3 sm:flex-row sm:gap-4 ${j > 0 ? 'border-t border-linea' : ''}`}>
                  <div class="flex-none text-[.86rem] font-semibold text-acento sm:w-[150px]">{d.q}</div>
                  <div class="text-[.95rem] text-tinta">{d.a}</div>
                </div>
              ))}
            </div>
          </div>

          <!-- Normas -->
          <div>
            <div class="eyebrow mb-2">Las normas</div>
            <ul class="space-y-2">
              {c.normas.map((n) => (
                <li class="flex items-start gap-2 text-[.95rem] text-suave">
                  <span aria-hidden="true" class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-md bg-[rgba(46,106,87,.15)] text-[.78rem] font-bold text-verde"><span class="block h-1.5 w-1.5 rounded-full bg-verde"></span></span>
                  {n}
                </li>
              ))}
            </ul>
          </div>

          <!-- Resultado -->
          <div>
            <div class="eyebrow mb-2">El resultado</div>
            <div class="overflow-hidden rounded-md border border-linea bg-crema">
              <div class="px-4 pt-3 pb-2">
                <div class="mb-[6px] text-[.74rem] font-bold text-suave">El encargo</div>
                <p class="text-[.92rem] italic text-tinta">"{c.entrada}"</p>
              </div>
              <div class="border-t border-linea bg-acento-claro px-4 py-3">
                <div class="mb-[6px] text-[.74rem] font-bold text-acento">La respuesta del asistente</div>
                <p class="whitespace-pre-line text-[.92rem] text-tinta">{c.salida}</p>
              </div>
            </div>
          </div>

          <!-- Mejora -->
          <div class="rounded-md border-l-4 border-acento bg-[#f3f9f6] px-5 py-4">
            <div class="mb-1 text-[.82rem] font-bold text-acento">Cómo mejora con el uso</div>
            <p class="text-[.95rem] text-tinta">{c.mejora}</p>
          </div>

        </div>
      </article>
    ))}
  </div>

  <div class="mx-auto mt-12 mb-[60px] max-w-[820px] px-6 text-center">
    <p class="mb-5 text-[1.05rem] text-suave">{cierre.texto}</p>
    <a href={cierre.href} class="btn-acento text-[1.05rem]">{cierre.cta}</a>
    <p class="mt-8 text-[.9rem] text-suave"><a href="/nivel-3" class="lnk">← Volver al recorrido por niveles</a></p>
  </div>

</Layout>
