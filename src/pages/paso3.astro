---
import Layout from '../layouts/Layout.astro';
// 24/09/2026: cada casilla abre un campo para escribir el dato. Antes el texto
// final recibía el rótulo de la casilla («A qué me dedico y dónde trabajo») y
// no el dato, así que Claude recibía el título sin contenido. Ahora solo pasan
// al resultado las casillas con el dato escrito, como «Rótulo: dato».
const opciones = [
  { cat: '1 · Quién eres', sub: 'Lo básico, para que no tenga que volver a preguntártelo.', items: [
    { r: 'Mi oficio y dónde trabajo', b: 'Tu oficio y dónde trabajas.', s: 'Para que adapte las respuestas a tu trabajo.', ph: 'Ej.: fontanero, trabajo en Madrid' },
    { r: 'Mi negocio y a qué se dedica', b: 'Tu negocio y a qué se dedica.', s: 'Para que use el nombre sin que se lo digas cada vez.', ph: 'Ej.: Aroma, tienda de café de tueste propio' },
    { r: 'Si trabajo solo o con equipo', b: 'Si trabajas solo o con equipo.', s: 'Cambia el tipo de ayuda que te ofrece.', ph: 'Ej.: somos tres personas' },
  ]},
  { cat: '2 · Con quién y con qué trabajas', sub: 'El contexto que se aplica a todas las tareas.', items: [
    { r: 'Cómo son mis clientes', b: 'Cómo son tus clientes.', s: 'Con esto adapta el tono y los ejemplos.', ph: 'Ej.: gente mayor, poco habituada a la tecnología' },
    { r: 'Herramientas que uso', b: 'Qué herramientas usas.', s: 'Para que no te proponga programas que no tienes.', ph: 'Ej.: Gmail, Excel y una tienda en Shopify' },
    { r: 'Proveedores o colaboradores habituales', b: 'Tus proveedores o colaboradores habituales.', s: 'Los que aparecen a menudo en tus tareas.', ph: 'Ej.: la gestoría y la empresa de transporte' },
  ]},
  { cat: '3 · Tus preferencias fijas', sub: 'Detalles que siempre quieres igual y que cansa repetir.', items: [
    { r: 'Idioma de las respuestas', b: 'En qué idioma te responde.', s: 'Castellano, catalán o el que uses.', ph: 'Ej.: castellano' },
    { r: 'Moneda y formato de fecha', b: 'Moneda y formato de fecha.', s: 'Para no tener que corregirlo en cada respuesta.', ph: 'Ej.: euros y día/mes/año' },
    { r: 'Largo de las respuestas', b: 'Respuestas cortas o detalladas.', s: 'El largo que te resulta más útil.', ph: 'Ej.: cortas, de tres o cuatro frases' },
  ]},
  { cat: '4 · Decisiones que ya tomaste', sub: 'Para no volver a discutir lo mismo cada semana.', items: [
    { r: 'Decisiones ya tomadas', b: 'Lo que ya está decidido.', s: 'Lo que no quieres que vuelva a plantearte.', ph: 'Ej.: no hago envíos fuera de España' },
    { r: 'Formas de trabajar que me funcionan', b: 'Tu forma de hacer las cosas.', s: 'Lo que ya sabes que te funciona.', ph: 'Ej.: primero el presupuesto y después la visita' },
  ]},
];
---
<Layout title="Su memoria · Tu primer asistente de IA">

  <div class="mx-auto max-w-[940px] px-6 pb-16">

    <!-- BARRA DE PROGRESO -->
    <div class="py-[26px] pb-2">
      <div class="mb-2 flex justify-between text-[.78rem] text-suave">
        <span>Lo que sabe de ti</span>
        <span>Paso 3 de 3 · Su memoria</span>
      </div>
      <div class="h-[7px] overflow-hidden rounded-full bg-linea">
        <div class="h-full rounded-full bg-acento transition-[width_.35s_ease]" style="width:75%"></div>
      </div>
    </div>

    <!-- INTRO -->
    <div class="mb-5 rounded-lg bg-tinta px-[30px] py-[30px] text-[#eef0f3]">
      <h2 class="mb-2 text-[1.5rem] font-bold tracking-tight">Qué datos tuyos tiene en cuenta, para no repetírselos cada vez</h2>
      <p class="text-[.98rem] text-[#c3c9d2]">
        Si el comportamiento es <b class="text-white">cómo</b> actúa, la memoria es <b class="text-white">lo que sabe de ti</b>:
        tu oficio, tu negocio o tus clientes. Sin estos datos, en cada conversación tienes que volver a contarle quién eres.
        Marca los que quieras incluir y <b class="text-white">escribe el dato en el campo que aparece</b>, o añade los tuyos al final.
        No hace falta completarlo todo hoy, porque la memoria crece con el uso.
      </p>
    </div>

    <!-- recordatorio: esto aún no es la IA -->
    <p class="mb-4 text-[.82rem] leading-relaxed text-suave">Esta web todavía no es la IA: sigues preparando el texto, que al final llevarás a tu Claude.</p>

    <!-- PRIVACIDAD en el punto de entrada de datos -->
    <div class="mb-5 rounded-md border border-acento-claro bg-[#eef6f2] px-4 py-3 text-[.86rem] text-tinta [&_b]:text-acento">
      <b>Lo que escribes aquí se queda en tu navegador</b> y no se envía a ningún sitio. Aun así, no hacen falta datos sensibles: basta con que el asistente sepa <b>cómo</b> son tus clientes o <b>qué</b> herramientas usas, sin nombres ni datos privados de nadie.
    </div>

    <!-- LAYOUT DOS COLUMNAS -->
    <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-[1fr_300px]">

      <!-- BIBLIOTECA -->
      <div class="flex flex-col gap-[22px]">

        {opciones.map((g) => (
          <div class="cat">
            <h3 class="mb-1 text-[1.08rem] font-bold tracking-tight">{g.cat}</h3>
            <div class="mb-3 text-[.85rem] text-suave">{g.sub}</div>
            {g.items.map((o) => (
              <div class="mem">
                <label class="opcion"><input type="checkbox" data-r={o.r}><span class="txt"><b>{o.b}</b><span>{o.s}</span></span></label>
                <input type="text" class="dato oculto" placeholder={o.ph} aria-label={`${o.r}: escribe el dato`} />
              </div>
            ))}
          </div>
        ))}

        <!-- 5 · Lo tuyo: entrada múltiple -->
        <div class="cat">
          <h3 class="mb-1 text-[1.08rem] font-bold tracking-tight">5 · Lo tuyo</h3>
          <div class="mb-3 text-[.85rem] text-suave">Cualquier otro dato que quieras que tenga en cuenta. Escríbelo y pulsa <b>Añadir</b>. Puedes añadir varios.</div>
          <div class="flex gap-2">
            <input class="anade flex-1" id="propia" placeholder="Ej.: 'mi web es ...', 'cierro los lunes'" />
            <button type="button" aria-label="Añadir dato" class="rounded-xl border-[1.5px] border-linea px-4 py-[11px] text-[.9rem] font-semibold text-tinta transition hover:border-acento hover:text-acento whitespace-nowrap" id="add-propia">Añadir +</button>
          </div>
          <div class="mt-[10px] flex flex-wrap gap-2" id="propias-list"></div>
        </div>

      </div>

      <!-- PANEL LATERAL -->
      <aside aria-label="Resumen de los datos que tendrá en cuenta" class="sticky top-[18px] rounded-lg bg-tinta p-5 text-[#eef0f3]">
        <div class="mb-1 text-[.78rem] font-bold text-[#7ec8ad]">Lo que sabrá de ti</div>
        <h4 class="mb-3 text-[1rem] font-semibold text-white">Esto es su memoria</h4>
        <div class="min-h-[60px] text-[.85rem] leading-[1.7] text-[#cfd4dc]" id="lista">
          <span class="italic text-[#7c8493]">Lo que marques y escribas aparecerá aquí…</span>
        </div>
        <div class="mt-[14px] border-t border-[#343b49] pt-[10px] text-[.8rem] text-[#9aa1ac]" id="cuenta">0 datos</div>
      </aside>

    </div>

    <!-- NOTA -->
    <div class="mt-[26px] rounded-md border border-acento-claro bg-[#eef6f2] px-[16px] py-[14px] text-[.9rem] text-tinta">
      <b class="text-acento">La memoria crece con el uso:</b> no hace falta llenarla el primer día. Empieza con los datos que tengas claros
      y añade los demás a las instrucciones de tu proyecto <b>a medida que veas que el asistente los necesita</b>.
    </div>

    <!-- NAVEGACIÓN -->
    <div class="mt-[18px] flex items-center justify-between gap-3">
      <a class="inline-flex min-h-[44px] items-center rounded-xl px-4 py-3 font-semibold text-suave transition hover:text-tinta" href="/paso2">&larr; Atrás</a>
      <button
        class="rounded-xl bg-acento px-[26px] py-3 font-semibold text-white shadow-[0_5px_16px_rgba(46,106,87,.25)] transition hover:-translate-y-0.5"
        id="siguiente"
      >Ver mi asistente terminado &rarr;</button>
    </div>

  </div>

</Layout>

<style>
  .opcion {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    background: var(--color-papel);
    border: 1px solid var(--color-linea);
    border-radius: 12px;
    padding: 13px 15px;
    margin-bottom: 9px;
    cursor: pointer;
    transition: border-color .12s, background .12s;
  }
  .opcion:hover { border-color: var(--color-acento); }
  .opcion.on { border-color: var(--color-acento); background: #eef6f2; }
  /* Foco de teclado: el label entero (área clicable ≥44px) muestra el anillo
     cuando el checkbox interno recibe foco (RAG_UI reglas 22 y 28). */
  .opcion:focus-within {
    outline: 3px solid var(--color-acento);
    outline-offset: 2px;
  }
  .opcion input {
    margin-top: 4px;
    accent-color: var(--color-acento);
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
  }
  .opcion .txt b { display: block; font-size: .96rem; color: var(--color-tinta); }
  .opcion .txt span { font-size: .84rem; color: var(--color-suave); }
  /* Campo del dato: aparece al marcar la casilla, pegado a ella. */
  .dato {
    display: block;
    width: 100%;
    min-height: 44px;
    margin: -4px 0 12px;
    border: 1.5px solid var(--color-acento);
    border-radius: 12px;
    padding: 10px 14px;
    font-family: inherit;
    font-size: .92rem;
    background: #fff;
    color: var(--color-tinta);
  }
  .dato:focus { outline: 3px solid var(--color-acento); outline-offset: 2px; }
  .dato.oculto { display: none; }
  .anade {
    border: 1.5px dashed var(--color-linea);
    border-radius: 12px;
    padding: 11px 14px;
    font-family: inherit;
    font-size: .92rem;
    background: transparent;
    color: var(--color-tinta);
  }
  .anade:focus { outline: 3px solid var(--color-acento); outline-offset: 2px; border-color: var(--color-acento); }
  .pitem {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #eef6f2;
    border: 1px solid var(--color-acento-claro);
    border-radius: 20px;
    padding: 6px 6px 6px 13px;
    font-size: .86rem;
    color: var(--color-tinta);
  }
  .pitem button {
    border: none;
    background: var(--color-acento-claro);
    color: var(--color-acento);
    border-radius: 50%;
    width: 20px;
    height: 20px;
    cursor: pointer;
    font-size: .95rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pitem button:hover { background: var(--color-acento); color: #fff; }
  @media (max-width: 780px) {
    aside { position: static; }
  }
</style>

<script>
  // Claves de localStorage:
  //   ht_memoria          líneas finales que lee el resultado («Rótulo: dato» y las propias)
  //   ht_memoria_datos    { rótulo: dato } de cada casilla marcada, para restaurar
  //   ht_memoria_propias  lo añadido a mano en «Lo tuyo»
  var checks = document.querySelectorAll('.opcion input');
  var lista = document.getElementById('lista');
  var cuenta = document.getElementById('cuenta');
  var propia = document.getElementById('propia');
  var addBtn = document.getElementById('add-propia');
  var propiasList = document.getElementById('propias-list');
  var propias = [];

  function campo(c) { return c.closest('.mem').querySelector('.dato'); }
  function esc(t) { return t.replace(/&/g, '&amp;').replace(/</g, '&lt;'); }

  (function restaurar() {
    var datos = {};
    try { datos = JSON.parse(localStorage.getItem('ht_memoria_datos') || '{}') || {}; } catch(e) { datos = {}; }
    try { propias = JSON.parse(localStorage.getItem('ht_memoria_propias') || '[]'); } catch(e) { propias = []; }
    if (!Array.isArray(propias)) { propias = []; }
    checks.forEach(function(c) {
      var r = c.getAttribute('data-r');
      if (Object.prototype.hasOwnProperty.call(datos, r)) {
        c.checked = true;
        campo(c).value = datos[r] || '';
      }
    });
  })();

  function pintarPropias() {
    propiasList.innerHTML = '';
    propias.forEach(function(p, i) {
      var chip = document.createElement('span');
      chip.className = 'pitem';
      chip.innerHTML = '<span></span><button type="button">&times;</button>';
      chip.querySelector('span').textContent = p;
      chip.querySelector('button').setAttribute('aria-label', 'Quitar: ' + p);
      chip.querySelector('button').addEventListener('click', function() {
        propias.splice(i, 1);
        pintarPropias();
        pintar();
      });
      propiasList.appendChild(chip);
    });
  }

  function pintar() {
    var lineas = [];
    var visibles = [];
    var datos = {};
    var pendientes = 0;
    checks.forEach(function(c) {
      var r = c.getAttribute('data-r');
      var f = campo(c);
      c.closest('.opcion').classList.toggle('on', c.checked);
      f.classList.toggle('oculto', !c.checked);
      if (!c.checked) return;
      var v = f.value.trim();
      datos[r] = v;
      if (v) {
        lineas.push(r + ': ' + v);
        visibles.push('· ' + esc(r + ': ' + v));
      } else {
        pendientes++;
        visibles.push('· ' + esc(r) + ': <span class="italic text-[#7c8493]">falta escribir el dato</span>');
      }
    });
    propias.forEach(function(p) { lineas.push(p); visibles.push('· ' + esc(p)); });
    if (visibles.length) {
      lista.innerHTML = visibles.join('<br>');
    } else {
      lista.innerHTML = '<span class="italic text-[#7c8493]">Lo que marques y escribas aparecerá aquí…</span>';
    }
    var txt = lineas.length + (lineas.length === 1 ? ' dato' : ' datos');
    if (pendientes) { txt += ' · ' + pendientes + (pendientes === 1 ? ' casilla sin dato, que no pasará al texto final' : ' casillas sin dato, que no pasarán al texto final'); }
    cuenta.textContent = txt;
    localStorage.setItem('ht_memoria', JSON.stringify(lineas));
    localStorage.setItem('ht_memoria_datos', JSON.stringify(datos));
    localStorage.setItem('ht_memoria_propias', JSON.stringify(propias));
  }

  function anadir() {
    var v = propia.value.trim();
    if (!v) return;
    propias.push(v);
    propia.value = '';
    pintarPropias();
    pintar();
    propia.focus();
  }

  addBtn.addEventListener('click', anadir);
  propia.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); anadir(); }
  });
  checks.forEach(function(c) {
    c.addEventListener('change', function() {
      pintar();
      if (c.checked) { campo(c).focus(); }
    });
    campo(c).addEventListener('input', pintar);
  });

  document.getElementById('siguiente').addEventListener('click', function() {
    pintar();
    window.location.href = '/resultado';
  });

  pintarPropias();
  pintar();
</script>
